# Two owned Vercel identities for Target #1 (control-plane authz).
# Copy to .env.local (gitignored). Do not paste tokens into chat.

# Account A — victim
VERCEL_TOKEN_A=
VERCEL_TEAM_ID_A=
VERCEL_PROJECT_ID_A=
# Optional second project on the same team (same-team IDOR)
VERCEL_PROJECT_ID_A2=

# Account B — attacker
VERCEL_TOKEN_B=
VERCEL_TEAM_ID_B=
VERCEL_PROJECT_ID_B=

# Optional OIDC (expires ~12h after `vercel env pull`)
# VERCEL_OIDC_TOKEN_A=
# VERCEL_OIDC_TOKEN_B=
