{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/cli.ts",
    "loader-demo.tsx",
    "src/core/api/index.ts",
    "src/core/ai/index.ts",
    "scripts/**/*.ts",
    "src/core/benchmark/**/*.ts",
    "src/core/agents/specialized/benchmark/**/*.{ts,tsx}",
    "src/core/agents/specialized/benchmarkComparisonAgent.ts",
    "src/core/agents/specialized/authenticationAgent/index.ts",
    "src/core/agents/specialized/environment/index.ts",
    "src/core/agents/specialized/patching/index.ts",
    "src/core/agents/specialized/codeAgent/schemas.ts",
    "src/core/agents/specialized/attackSurface/schemas.ts",
    "src/core/agents/offSecAgent/index.ts",
    "src/core/agents/offSecAgent/tools/index.ts",
    "src/lib/cvss/index.ts",
    "src/core/ai/index.ts",
    "src/core/ai/ai.ts",
    "src/core/prompt-injections/index.ts",
    "src/core/session/index.ts",
    "src/core/workflows/whiteboxAttackSurface.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "loader-demo.tsx"],
  "ignoreDependencies": ["@playwright/mcp"],
  "ignore": [
    "**/*.test.{ts,tsx,js,jsx,mts,cts}",
    "**/*.spec.{ts,tsx,js,jsx,mts,cts}",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/testkit.ts"
  ],
  "vitest": false,
  "tags": ["-knipignore"],
  "ignoreExportsUsedInFile": true,
  "include": [
    "files",
    "dependencies",
    "unlisted",
    "duplicates",
    "types",
    "nsTypes",
    "exports",
    "nsExports"
  ]
}
